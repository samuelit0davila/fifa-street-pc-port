<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.1.3</Version>
    <ApplicationIcon>fifastreet.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="cover.jpg" LogicalName="cover.jpg" />
    <EmbeddedResource Include="fifastreet.ico" LogicalName="fifastreet.ico" />
    <Compile Include="..\..\Installer\FifaStreetSetupTool\ThemeKit.cs" Link="ThemeKit.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <None Include="ui\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
